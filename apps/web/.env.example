# MSSQL Database Connection URL (Default Docker Container Port: 6063)
DATABASE_URL="sqlserver://localhost:6063;database=InventoryDB;user=sa;password=<YOUR_MSSQL_SA_PASSWORD>;encrypt=true;trustServerCertificate=true;"

# JWT Secret Key for Authentication Session Cookie
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Microsoft Entra ID (Azure AD) OAuth 2.0 Configuration
MICROSOFT_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MICROSOFT_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MICROSOFT_TENANT_ID="common"
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI="http://localhost:6060/api/auth/microsoft/callback"
FRONTEND_URL="http://localhost:6061"
